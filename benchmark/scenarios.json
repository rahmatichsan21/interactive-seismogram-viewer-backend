    {
      "id": "op_trim",
      "label": "Trim",
      "kind": "process_local",
      "operations": [
        {
          "type": "trim",
          "start_time": "__DATA_START__",
          "end_time": "__DATA_MID__"
        }
      ]
    },
    {
      "id": "op_bandpass",
      "label": "Bandpass 1-10 Hz",
      "kind": "process_local",
      "operations": [
        {
          "type": "filter",
